{"cleanUrls":true,
"rewrites":[{"source":"/api/:r","destination":"/api/index?r=:r"}],
"headers":[
{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Referrer-Policy","value":"same-origin"}]},
{"source":"/admin","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"Cache-Control","value":"no-store"}]}]}
